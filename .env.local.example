# ---------------------------------------------------------------- database
# Any PostgreSQL 14+ instance: self-hosted, Aliyun RDS/PolarDB, RDS, Neon…
# Append ?sslmode=require for a managed instance that refuses plaintext.
DATABASE_URL=postgresql://user:password@host:5432/voicelens?sslmode=require
# Optional: pool size per process (web defaults to 10, worker to 8).
# DATABASE_POOL_MAX=10
# Set to true to verify the server certificate against the system CA store.
# DATABASE_SSL_STRICT=false

# ---------------------------------------------------------------- auth
# Signs the session cookie. At least 32 characters; rotating it logs everyone out.
# Generate with: openssl rand -base64 48
AUTH_SECRET=<random-48-bytes-base64>

# Encrypts the model API keys stored in the database. Optional: when unset,
# AUTH_SECRET is used instead. Set it if you want to be able to rotate
# AUTH_SECRET (which logs everyone out) without invalidating the stored model
# keys — a rotation without MODEL_SECRET means re-entering every key in
# 设置 → 分析模型. At least 32 characters.
# MODEL_SECRET=<random-48-bytes-base64>

# ---------------------------------------------------------------- object storage
# S3-compatible endpoint for conversation audio. Example is Aliyun OSS.
# The bucket stays PRIVATE: every read goes through a short-lived presigned URL.
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_REGION=oss-cn-beijing
S3_BUCKET=voicelens-audio
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<access-key-secret>
# OSS and AWS S3 address buckets as <bucket>.<endpoint>; MinIO and some
# gateways need the bucket in the path instead.
# S3_FORCE_PATH_STYLE=false
#
# The browser uploads archives straight to this bucket over presigned PUT URLs,
# so the bucket needs a CORS rule allowing PUT from the app's origin. See the
# "导入上传" section of the README.

# ---------------------------------------------------------------- import
# Ceiling on one uploaded archive, in MB (default 5120 = 5GB). Upload and parse
# are both streamed now, so this is a sanity guard rather than a memory limit.
# IMPORT_MAX_ZIP_MB=5120
# Keep the uploaded archive in the bucket after a successful import. Off by
# default: the audio inside it has already been unpacked to its own objects.
# IMPORT_KEEP_SOURCE_ZIP=false

# ---------------------------------------------------------------- model
# Nothing to configure here. Models are configured in the app, by the owner,
# under 设置 → 分析模型: any number of OpenAI-compatible endpoints, each marked
# as a multimodal (text+image) or an omni (text+image+audio) model. The API
# keys are encrypted with MODEL_SECRET/AUTH_SECRET before they are stored.

# ---------------------------------------------------------------- worker
WORKER_POLL_MS=2500
# 一个 Worker 同时持有几个作业。报告阶段会整段占用一个 Chromium（渲染 + 截图），
# 小机器上并发几个作业就是几个浏览器，内存不够会被 OOM 掉。
# WORKER_MAX_ACTIVE=3

# ---- 报告页面的生成（见 README〈报告是怎么生成出来的〉）----------------------
# 报告页面由模型对着真实浏览器写：渲染 → 把判定结果和截图发回给模型 → 它自己改。
# 没有浏览器时这一整段会被跳过，报告等于没人看过就发出去了（Worker 启动 banner 里会写明）。
# 镜像里已经装好发行版 chromium 并指向它；本机开发时指向自己的一个 Chromium：
# VOICELENS_CHROMIUM_PATH=/usr/bin/chromium
# 循环轮数上限，每轮一次模型调用（默认 6）
# VOICELENS_REPORT_MAX_TURNS=6
# 模型不支持图像输入时才关掉（关掉后它就看不见自己写的页面了）
# VOICELENS_REPORT_VISION=off

# ---------------------------------------------------------------- container only
# Read by the image entrypoint; ignored when running with npm. See README.
# Which process the container runs when no command argument is given.
# VOICELENS_ROLE=all              # web (default) | worker | all | migrate
# Apply db/migrations before web/all start. db/apply.ts takes no lock, so only
# one container per database may turn this on.
# VOICELENS_MIGRATE_ON_START=true
