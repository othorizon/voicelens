# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Dedicated member account used by the background worker.
# It is auto-registered through the public.register_user RPC on first start.
SUPABASE_SERVICE_EMAIL=agent@voice-insight.local
SUPABASE_SERVICE_PASSWORD=<random-32-chars>

# Model Studio, OpenAI-compatible endpoint
AI_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxxxxxxx
AI_MODEL=qwen3.8-omni-flash
# Reasoning mode is expensive; the engine enables it only for planning and report writing.
AI_ENABLE_THINKING=false

# Worker tuning
WORKER_POLL_MS=2500
WORKER_CONCURRENCY=4
SUPABASE_STORAGE_BUCKET=audio
